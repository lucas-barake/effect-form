{
  "name": "@lucas-barake/effect-form-solid",
  "version": "0.0.0-beta.2",
  "description": "Solid bindings for @lucas-barake/effect-form",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.ts",
        "solid": "./dist/index.jsx",
        "default": "./dist/index.js"
      },
      "./FormSolid": {
        "types": "./dist/FormSolid.d.ts",
        "solid": "./dist/FormSolid.jsx",
        "default": "./dist/FormSolid.js"
      },
      "./internal/*": null
    }
  },
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./FormSolid": "./src/FormSolid.tsx",
    "./internal/*": null
  },
  "files": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "dist/**/*.js",
    "dist/**/*.jsx",
    "dist/**/*.js.map",
    "dist/**/*.jsx.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lucas-barake/effect-form.git"
  },
  "homepage": "https://github.com/lucas-barake/effect-form",
  "scripts": {
    "build": "tsc -b tsconfig.json && rollup -c",
    "build:tsgo": "tsgo -b tsconfig.json"
  },
  "keywords": [
    "effect",
    "form",
    "solid",
    "schema",
    "validation",
    "typescript"
  ],
  "author": "Lucas Barake",
  "license": "MIT",
  "sideEffects": [],
  "dependencies": {
    "@lucas-barake/effect-form": "workspace:^"
  },
  "devDependencies": {
    "@effect/atom-solid": "4.0.0-beta.52",
    "@solidjs/testing-library": "^0.8.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@babel/preset-typescript": "^7.26.0",
    "@rollup/plugin-babel": "6.0.4",
    "@rollup/plugin-node-resolve": "15.3.0",
    "babel-preset-solid": "^1.9.3",
    "effect": "4.0.0-beta.52",
    "rollup": "^4.27.4",
    "solid-js": "^1.9.12",
    "vite-plugin-solid": "^2.11.12"
  },
  "peerDependencies": {
    "@effect/atom-solid": ">=4.0.0-beta.52 <4.0.1",
    "effect": ">=4.0.0-beta.52 <4.0.1",
    "solid-js": ">=1 <2"
  }
}
